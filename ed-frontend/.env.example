# Base URL of the Django backend. Use your machine's LAN IP (not 127.0.0.1)
# so physical devices / emulators can reach it. In production, your API domain.
API_BASE_URL=http://192.168.0.125:8000

# Android-only: Google Maps API key for react-native-maps. iOS uses Apple Maps.
# Leave blank in dev; the Android map is blank without it.
GOOGLE_MAPS_ANDROID_API_KEY=
