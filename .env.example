# Root env for docker-compose / Dokploy. Copy to .env and fill in.
POSTGRES_DB=umi
POSTGRES_USER=umi
POSTGRES_PASSWORD=change-me

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.com,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
WEB_PORT=8000

# Optional first-boot data seed (path inside the web container)
# LOAD_INITIAL_DATA=/app/seed.json
