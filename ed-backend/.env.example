# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database — Postgres only. In compose this points at the `db` service;
# for manage.py on the host use localhost (bring the db up: docker compose up db).
DATABASE_URL=postgres://umi:umi@localhost:5432/umi

# Optional: create a fresh superuser on first boot (see entrypoint.sh)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
# DJANGO_SUPERUSER_PASSWORD=change-me

# Optional: path to a dumpdata JSON to seed on first boot (see DEPLOY.md)
# LOAD_INITIAL_DATA=/app/seed.json
