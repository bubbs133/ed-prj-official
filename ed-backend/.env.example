# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database (leave unset to use local sqlite in development)
DATABASE_URL=postgres://umi:umi@db:5432/umi

# Optional: path to a dumpdata JSON to seed on first boot (see DEPLOY.md)
# LOAD_INITIAL_DATA=/app/seed.json
